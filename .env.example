# ============================================
# Environment Variables Template
# Copy this file to `.env` and fill in your
# real values. NEVER commit your real `.env`.
# ============================================

# --- Flask / Application ---
# Used to sign session cookies & CSRF tokens.
# Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret

# --- Database ---
# PostgreSQL URL for production (Render/Heroku).
# Leave blank to use local SQLite (grievance_hub.db).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Supabase (optional) ---
# If using Supabase for additional services.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# --- Email (SendGrid/Brevo) ---
# SMTP via SendGrid
MAIL_SERVER=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=apikey
MAIL_PASSWORD=your-sendgrid-api-key

# Alternative email provider (Brevo)
BREVO_API_KEY=your-brevo-api-key

# Default sender address for outgoing emails
MAIL_DEFAULT_SENDER=no-reply@example.com

# --- Default Admin (for setup scripts) ---
ADMIN_USERNAME=vanitha
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# --- Server ---
# Port used by the app (Render sets this automatically)
PORT=10000
